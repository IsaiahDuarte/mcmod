<?xml version="1.0"?>
<ruleset name="Factory Core" xmlns="http://pmd.sourceforge.net/ruleset/2.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://pmd.sourceforge.net/ruleset/2.0.0 https://pmd.github.io/schema/ruleset_2_0_0.xsd">
    <description>Correctness checks for production and test Java.</description>
    <rule ref="category/java/errorprone.xml/EmptyCatchBlock"/>
    <rule ref="category/java/errorprone.xml/ReturnFromFinallyBlock"/>
    <rule ref="category/java/errorprone.xml/BrokenNullCheck"/>
    <!-- Minecraft lends levels, servers and the client window; mod code never owns or closes
         them. PMD's own defaults are kept and these borrowed handles are added, instead of a
         suppression at every call site. -->
    <rule ref="category/java/errorprone.xml/CloseResource">
        <properties>
            <property name="allowedResourceTypes" value="java.io.ByteArrayOutputStream|java.io.ByteArrayInputStream|java.io.StringWriter|java.io.CharArrayWriter|java.util.stream.Stream|java.util.stream.IntStream|java.util.stream.LongStream|java.util.stream.DoubleStream|net.minecraft.server.MinecraftServer|net.minecraft.server.level.ServerLevel|net.minecraft.world.level.Level|net.minecraft.client.Minecraft|com.mojang.blaze3d.platform.Window|net.minecraft.client.multiplayer.ClientLevel"/>
        </properties>
    </rule>
    <rule ref="category/java/multithreading.xml/AvoidThreadGroup"/>
</ruleset>
