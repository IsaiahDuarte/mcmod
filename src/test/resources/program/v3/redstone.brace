every 10 ticks as "export" {
  if redstone(machines("button")) {
    move item("cobblestone") from storage to machines("out")
    emit redstone 15 on machines("busy")
  }
}
every 10 ticks {
  if not redstone(machines("button")) {
    emit redstone 0 on machines("busy")
    emit redstone 7 on machines("lamp")
  }
}